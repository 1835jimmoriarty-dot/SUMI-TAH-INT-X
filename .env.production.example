# ============================================================
# SUMI-TAH — Production Environment Variables Template
# Copy to .env and fill in real values BEFORE deployment.
# NEVER commit your filled-in .env to version control.
# ============================================================

# ── Database (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=sumitah_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sumitah_prod

# ── Application ───────────────────────────────────────────
NODE_ENV=production

# JWT signing key — minimum 32 random characters
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET

# AES-256-GCM key for encrypting connector secrets at rest (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_AES256_KEY

# Session expiry in hours (default 24)
SESSION_EXPIRY_HOURS=24

# ── AI / LLM Provider ────────────────────────────────────
# Options: mock | openai | vertexai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Redis Cache (optional) ────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── SIEM Connector Credentials (optional — also configurable in UI) ─
LOGSCALE_API_KEY=
LOGSCALE_BASE_URL=

SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=

SPLUNK_BASE_URL=
SPLUNK_HEC_TOKEN=

CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=