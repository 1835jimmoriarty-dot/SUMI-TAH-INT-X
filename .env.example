# ==============================================================================
# SUMI-TAH — Environment Configuration Reference
# ==============================================================================

# Database Configuration
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Minimum 32 characters)
JWT_SECRET="sumitah-jwt-secret-key-change-in-production-2026"
SESSION_EXPIRY_HOURS="24"

# Secret Encryption at Rest (32-byte hex key for AES-256-GCM: 64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SUMI-TAH"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_ENABLE_DEMO_BANNER="true"

# Security Integrations (Optional Production Overrides)
CROWDSTRIKE_CLIENT_ID=""
CROWDSTRIKE_CLIENT_SECRET=""
LOGSCALE_API_KEY=""
SENTINEL_WORKSPACE_ID=""
SENTINEL_TENANT_ID=""
SENTINEL_CLIENT_ID=""
SENTINEL_CLIENT_SECRET=""
SPLUNK_HEC_TOKEN=""
SPLUNK_BASE_URL=""

# AI Advisory Engine Configuration (Optional)
AI_PROVIDER="mock" # options: mock, openai, azure
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Torq SOAR Automation Configuration (Optional)
TORQ_API_KEY=""
TORQ_ENDPOINT="https://api.torq.io/v1"
